# ============================================================
# Digital Archaeologist — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file with actual secrets.
# ============================================================

# --- General ---
ENVIRONMENT=development

# --- Security ---
JWT_SECRET=replace-with-a-long-random-string

# --- Database ---
# Local dev default (SQLite, zero setup): sqlite:///./digital_archaeologist.db
# Production (Postgres, used automatically by docker-compose):
DATABASE_URL=postgresql+psycopg2://da_user:change_me@localhost:5432/digital_archaeologist
POSTGRES_PASSWORD=change_me

# --- Vector database (RAG, pgvector) ---
VECTOR_DATABASE_URL=postgresql+psycopg2://da_user:change_me@localhost:5432/digital_archaeologist

# --- Neo4j (Knowledge Graph) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change_me

# --- LLM provider ---
# One of: claude | openai_compatible | local | demo
LLM_PROVIDER=demo
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-sonnet-4-6

# --- Provider mode ---
# true = every AI module uses its clearly-labelled Demo/Fallback provider.
# Set to false once real models/API keys above are configured.
USE_DEMO_PROVIDERS=true
